import CakeML.Prelude.PredSet
import Batteries.Data.List.Basic

/-
HOL4 library: `list` theory constants that have no exact Lean core counterpart.
The others map to Lean core / Batteries directly (see `lean/CONVENTIONS.md`):
`MAP` = `List.map`, `FOLDR` = `List.foldr`, `REVERSE` = `List.reverse`, `++` = `List.append`,
`MEM x l` = `x ∈ l`, `NULL l` = `l.isEmpty`, `LIST_REL` = `List.Forall₂`, `isPREFIX` = `List.IsPrefix`.
-/

universe u

namespace list

variable {α : Type u}

/- HOL4: list$EVERY
     (EVERY P [] = T) /\ (EVERY P (h::t) = P h /\ EVERY P t)   (EVERY_DEF) -/
/-- HOL4 `EVERY P l`. -/
def EVERY (P : α → Prop) : List α → Prop
  | [] => True
  | h :: t => P h ∧ EVERY P t

/- HOL4: list$LIST_TO_SET (overloaded as `set`)
     (LIST_TO_SET [] x ⇔ F) /\ (LIST_TO_SET (h::t) x ⇔ (x = h) \/ LIST_TO_SET t x)   (LIST_TO_SET_DEF)
   HOL4 `MEM h l` is an overload for `h IN LIST_TO_SET l`. -/
/-- HOL4 `set l` (`LIST_TO_SET l`): the set of members of `l`. -/
def LIST_TO_SET (l : List α) : pred_set.set α := fun x => x ∈ l

/- HOL4: list$list_size (generated by the datatype package for `list`)
     (list_size f [] = 0) /\ (list_size f (a0::a1) = 1 + (f a0 + list_size f a1)) -/
/-- HOL4 `list_size f l`. -/
def list_size (f : α → Nat) : List α → Nat
  | [] => 0
  | a0 :: a1 => 1 + (f a0 + list_size f a1)

end list
